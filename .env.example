# 复制为 .env 后按本地修改。不要把真实密钥提交进仓库。

# 本机 conda Postgres（scripts/pg_local.sh）默认端口 5433；Docker Compose 仍用 5432
DATABASE_URL=postgresql+psycopg://paper_agent@localhost:5433/paper_agent
REDIS_URL=redis://localhost:6379/0

PAPERS_DIR=论文
CORPUS_CONFIG=deploy/corpus.yaml
DATA_DIR=data

# 对话模型：运行时以管理后台「模型配置」为准。
# 以下变量仅在库空首次种子时写入数据库，之后请在 /admin 修改（勿把真实 Key 提交仓库）。
LLM_ENDPOINT=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 嵌入：有端点走 HTTP；否则 EMBEDDING_BACKEND=local 用 sentence-transformers 拉 BAAI/bge-m3
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_BACKEND=local
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# 国内拉取模型可设：HF_ENDPOINT=https://hf-mirror.com

# 重排序：混合检索后必须调用。本机可先用 bge-reranker-base；有条件再换 v2-m3
RERANKER_ENDPOINT=
RERANKER_API_KEY=
RERANKER_MODEL=bge-reranker-base
RERANKER_BACKEND=local
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-base
EMBEDDING_LOCAL_FILES_ONLY=1
RERANKER_LOCAL_FILES_ONLY=1

OCR_ENDPOINT=
OCR_API_KEY=

JWT_SECRET=change-me-in-local-dev
DAILY_TOKEN_LIMIT=200000
